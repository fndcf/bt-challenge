rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Ninguém acessa o banco direto: o app passa pela API, que usa o Admin SDK
    // (não sujeito a estas regras) e decide o que cada um pode ver e alterar.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
