rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Funções auxiliares
    // ============================================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário é admin da arena
    function isArenaAdmin(arenaId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.arenaId == arenaId;
    }

    // ============================================
    // Regras por coleção
    // ============================================

    // Arenas - leitura pública, escrita apenas por admin
    match /arenas/{arenaId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isArenaAdmin(arenaId);
    }

    // Admins - apenas o próprio admin pode ler/escrever
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false; // Gerenciado pelo backend
    }

    // Jogadores - leitura pública (para página pública da arena), escrita por admin da arena
    match /jogadores/{jogadorId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated()
        && resource != null
        && isArenaAdmin(resource.data.arenaId);
    }

    // Challenges (Etapas) - leitura pública, escrita por admin da arena
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated()
        && resource != null
        && isArenaAdmin(resource.data.arenaId);
    }

    // Duplas - leitura pública, escrita por admin da arena
    match /duplas/{duplaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Grupos - leitura pública, escrita por admin da arena
    match /grupos/{grupoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Partidas - leitura pública, escrita por admin da arena
    match /partidas/{partidaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Histórico de parceiros - leitura pública, escrita por admin
    match /historicoParceiros/{historicoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Ranking - leitura pública, escrita por admin
    match /ranking/{rankingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Bloquear acesso a qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
