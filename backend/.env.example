# ============================================
# Backend - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha os valores

# Configuração do Servidor
PORT=5000
NODE_ENV=development

# Firebase Admin SDK
# Obtenha em: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID="seu-projeto-firebase"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com"

# CORS - Origens permitidas (separar por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Emulators (descomente para usar emuladores locais)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
