# ============================================
# Backend - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha os valores

# Configuração do Servidor
PORT=5000
NODE_ENV=development

# Firebase Admin SDK
# Prefixo FB_ em vez de FIREBASE_ (reservado pelo Firebase Functions)
# Obtenha em: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FB_PROJECT_ID="seu-projeto-firebase"
FB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
FB_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com"

# CORS - Origens permitidas (separar por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Emulators (descomente para usar emuladores locais)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
